# Local dev (running `pnpm start:dev` directly on the host, NOT inside Docker).
# For docker compose, the root-level .env.example is used instead — DATABASE_URL/REDIS_URL
# there are built by docker-compose.yml from POSTGRES_* using the service names as hosts.
# Copy this file to `.env` and adjust as needed. Never commit the real `.env`.

NODE_ENV=development
PORT=3000

# Requires a local Postgres reachable at this URL (e.g. `docker compose up postgres -d`
# from the repo root, which publishes 5432 on localhost).
DATABASE_URL=postgresql://liquiverde:liquiverde@localhost:5432/liquiverde?schema=public
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_IN=2h

OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org
# Optional — leave empty to run with Open Food Facts only (USDA integration stays disabled).
USDA_API_KEY=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=LiquiVerde-Tech-Test/1.0 (contact: set-your-email@example.com)

CORS_ORIGIN=http://localhost:4200

# Sustainability scoring weights (must sum to 1)
SCORING_WEIGHT_ECONOMIC=0.4
SCORING_WEIGHT_ENV=0.35
SCORING_WEIGHT_SOCIAL=0.25

# Knapsack multi-objective weights (must sum to 1)
KNAPSACK_WEIGHT_UTILITY=0.34
KNAPSACK_WEIGHT_SUSTAINABILITY=0.33
KNAPSACK_WEIGHT_SAVING=0.33
KNAPSACK_DISCRETIZATION_STEP_CENTS=50
KNAPSACK_MAX_STEP_CENTS=5000
KNAPSACK_MAX_DP_CELLS=4000000
KNAPSACK_MAX_ITEMS_DP=500

# Substitution engine
SUBSTITUTION_MAX_PRICE_INCREASE_PCT=10
SUBSTITUTION_WEIGHT_SCORE=0.5
SUBSTITUTION_WEIGHT_PRICE=0.2
SUBSTITUTION_WEIGHT_SIMILARITY=0.3

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
